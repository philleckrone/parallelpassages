<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_File</sys:String>
    <sys:String x:Key="Menu_Open">_Open…</sys:String>
    <sys:String x:Key="Menu_Save">_Save</sys:String>
    <sys:String x:Key="Menu_SaveAs">Save _As…</sys:String>
    <sys:String x:Key="Menu_Reapply">_Reapply saved hidden list</sys:String>
    <sys:String x:Key="Menu_Exit">E_xit</sys:String>

    <!-- Toolbar / bars -->
    <sys:String x:Key="Toolbar_Language">Language:</sys:String>
    <sys:String x:Key="FileBar_Format">File: {0}</sys:String>
    <sys:String x:Key="FileBar_None">No file open</sys:String>
    <sys:String x:Key="Banner_RestartReminder">Restart Paratext after saving for the changes to take effect. The changes apply to every project on this computer.</sys:String>

    <!-- Panes -->
    <sys:String x:Key="Header_Books">Books (tick to hide)</sys:String>
    <sys:String x:Key="Header_Chapters">Chapters (tick to hide)</sys:String>
    <sys:String x:Key="Header_Entries">Entries in the selected book or chapters</sys:String>
    <sys:String x:Key="Count_Format">{0} / {1} hidden</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_HideBook">Hide book</sys:String>
    <sys:String x:Key="Btn_UnhideBook">Unhide book</sys:String>
    <sys:String x:Key="Btn_HideChapters">Hide chapter(s)</sys:String>
    <sys:String x:Key="Btn_UnhideChapters">Unhide chapter(s)</sys:String>
    <sys:String x:Key="Btn_UnhideAll">Unhide all</sys:String>

    <!-- Entry grid columns (used from code-behind) -->
    <sys:String x:Key="Column_Hidden">Hidden</sys:String>
    <sys:String x:Key="Column_Reference">Reference</sys:String>
    <sys:String x:Key="Column_ParallelWith">Parallel with</sys:String>
    <sys:String x:Key="Column_Text">Text</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Parallel Passages Editor</sys:String>
    <sys:String x:Key="Status_Unsaved">(unsaved)</sys:String>
    <sys:String x:Key="Status_Saved">Saved.</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} of {1} entries hidden</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Save Error</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Could not save the file:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Unsaved Changes</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">There are unsaved changes. Save before continuing?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Open ParallelPassages.xml</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Save ParallelPassages.xml As</sys:String>
    <sys:String x:Key="Dlg_OpenErrorTitle">Open Error</sys:String>
    <sys:String x:Key="Dlg_OpenErrorBody">Could not open the file:</sys:String>
    <sys:String x:Key="Dlg_NoVersesBody">No &lt;Verse&gt; entries were found in this file. Is it a ParallelPassages.xml file?</sys:String>
    <sys:String x:Key="Dlg_NotFoundTitle">File Not Found</sys:String>
    <sys:String x:Key="Dlg_NotFoundBody">ParallelPassages.xml was not found in the usual Paratext 9 folder (Program Files\Paratext 9\ParallelPassages). Please locate it.</sys:String>
    <sys:String x:Key="Dlg_AdminTitle">Administrator Rights Needed</sys:String>
    <sys:String x:Key="Dlg_AdminBody" xml:space="preserve">Windows did not allow saving to:&#10;{0}&#10;&#10;Administrator rights are needed to change files in Program Files. Restart the editor as administrator? Your changes will be carried over.</sys:String>
    <sys:String x:Key="Dlg_PendingTitle">Changes Carried Over</sys:String>
    <sys:String x:Key="Dlg_PendingAppliedBody">Your changes were carried over. Press Save to write them to the file.</sys:String>
    <sys:String x:Key="Dlg_PendingStaleBody">The file changed on disk after the editor restarted, so your earlier changes could not be carried over. Please make them again.</sys:String>
    <sys:String x:Key="Dlg_ReapplyTitle">Reapply Hidden List</sys:String>
    <sys:String x:Key="Dlg_ReapplyBody" xml:space="preserve">No entries are hidden in this file. Paratext may have replaced it during an update.&#10;&#10;Reapply your previous hidden list ({0} books, {1} chapters, {2} single entries)?</sys:String>
    <sys:String x:Key="Dlg_ReapplyConfirmBody">Replace the current hidden entries with your saved hidden list ({0} books, {1} chapters, {2} single entries)?</sys:String>
    <sys:String x:Key="Dlg_ReapplyNone">There is no saved hidden list yet. One is saved each time you save the file.</sys:String>
    <sys:String x:Key="Dlg_InvalidXmlBody">The changed file would not be valid XML, so nothing was saved.</sys:String>

    <!-- Two-entry rule / numbered backups -->
    <sys:String x:Key="Count_KeptFormat">{0} / {1} hidden, {2} with passage</sys:String>
    <sys:String x:Key="Column_Note">Note</sys:String>
    <sys:String x:Key="Note_Kept">Hidden with its passage: fewer than 2 entries would be left</sys:String>
    <sys:String x:Key="Status_SummaryKeptFormat">{0} of {1} entries hidden; {3} passages hidden entirely ({2} entries only because of that)</sys:String>
    <sys:String x:Key="Status_SavedBackupFormat">Saved. The original file was kept as {0}.</sys:String>
    <sys:String x:Key="Dlg_RepairTitle">Passages Repaired</sys:String>
    <sys:String x:Key="Dlg_RepairBody">{0} passages in this file have fewer than 2 visible entries, which can stop Paratext from loading. They will be hidden entirely when you save.</sys:String>

    <!-- Per-project saved list -->
    <sys:String x:Key="ProjectBar_Format">Project: {0}</sys:String>
    <sys:String x:Key="Check_SaveForProject">Save this hidden list for project {0}</sys:String>
    <sys:String x:Key="Dlg_ProjectListTitle">Saved List for This Project</sys:String>
    <sys:String x:Key="Dlg_ProjectListBody" xml:space="preserve">Project {0} has a saved hidden list ({1} books, {2} chapters, {3} single entries).&#10;&#10;Use it? Remember to save, then restart Paratext.</sys:String>
    <sys:String x:Key="Status_SavedForProject">The list for project {0} is saved when you close this window.</sys:String>
    <sys:String x:Key="Status_RemovedForProject">Project {0}'s saved list is removed when you close this window.</sys:String>

    <!-- Passages added by the user -->
    <sys:String x:Key="Menu_Readd">Add _back my saved passages</sys:String>
    <sys:String x:Key="Btn_AddPassage">Add passage…</sys:String>
    <sys:String x:Key="Btn_EditPassage">Edit passage…</sys:String>
    <sys:String x:Key="Btn_RemovePassage">Remove passage</sys:String>
    <sys:String x:Key="Btn_OK">OK</sys:String>
    <sys:String x:Key="Btn_Cancel">Cancel</sys:String>
    <sys:String x:Key="Note_Added">Added by you</sys:String>
    <sys:String x:Key="Status_AddedFormat">{0} passages added by you</sys:String>
    <sys:String x:Key="Dlg_AddPassageTitle">Add a Parallel Passage</sys:String>
    <sys:String x:Key="Dlg_EditPassageTitle">Edit a Parallel Passage</sys:String>
    <sys:String x:Key="Dlg_AddPassageHelp" xml:space="preserve">Type the references of the parallel passage, one per line (at least 2), for example:&#10;GEN 2:24&#10;MAT 19:5&#10;MRK 10:7-8&#10;Use the Original versification, as in Paratext's own list. Paratext has no word-by-word comparison for passages you add, so their words are not highlighted.</sys:String>
    <sys:String x:Key="Dlg_AddPassageNoVrs">Paratext 9 was not found in Program Files, so only the form of each reference is checked, not whether the verse exists.</sys:String>
    <sys:String x:Key="Dlg_RemovePassageTitle">Remove Passage</sys:String>
    <sys:String x:Key="Dlg_RemovePassageBody">Remove the passage {0}?</sys:String>
    <sys:String x:Key="Dlg_ReaddTitle">Passages You Added</sys:String>
    <sys:String x:Key="Dlg_ReaddBody" xml:space="preserve">{0} passages you added earlier are not in this file. Paratext may have replaced it during an update.&#10;&#10;{1}&#10;&#10;Add them again?</sys:String>
    <sys:String x:Key="Dlg_ReaddNone">All the passages you added are in this file. The list is saved each time you save the file.</sys:String>
    <sys:String x:Key="Dlg_PassageErrorTitle">Passage</sys:String>
    <sys:String x:Key="Err_LineFormat">Reference {0}: {1}</sys:String>
    <sys:String x:Key="Err_BadRef">&quot;{0}&quot; is not a reference like GEN 2:24, MRK 10:7-8 or 2CH 8:13,16.</sys:String>
    <sys:String x:Key="Err_Book">{0} is not a book of the Old or New Testament.</sys:String>
    <sys:String x:Key="Err_Order">&quot;{0}&quot;: the verses must be in order (10:7-8, 8:13,16).</sys:String>
    <sys:String x:Key="Err_Chapter">{0} does not exist: {1} has {2} chapters in the Original versification.</sys:String>
    <sys:String x:Key="Err_Verse">&quot;{0}&quot; does not exist: {1} has {2} verses in the Original versification.</sys:String>
    <sys:String x:Key="Err_Duplicate">{0} is already reference {1}.</sys:String>
    <sys:String x:Key="Err_TooFew">A passage needs at least 2 references.</sys:String>
    <sys:String x:Key="Err_Exists">This passage is already in the file (line {0}: {1}).</sys:String>

</ResourceDictionary>
