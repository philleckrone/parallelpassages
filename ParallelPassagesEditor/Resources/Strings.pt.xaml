<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Menu -->
    <sys:String x:Key="Menu_File">_Arquivo</sys:String>
    <sys:String x:Key="Menu_Open">_Abrir…</sys:String>
    <sys:String x:Key="Menu_Save">_Salvar</sys:String>
    <sys:String x:Key="Menu_SaveAs">Salvar _como…</sys:String>
    <sys:String x:Key="Menu_Reapply">_Reaplicar a lista de ocultos salva</sys:String>
    <sys:String x:Key="Menu_Exit">Sa_ir</sys:String>

    <!-- Toolbar / bars -->
    <sys:String x:Key="Toolbar_Language">Idioma:</sys:String>
    <sys:String x:Key="FileBar_Format">Arquivo: {0}</sys:String>
    <sys:String x:Key="FileBar_None">Nenhum arquivo aberto</sys:String>
    <sys:String x:Key="Banner_RestartReminder">Reinicie o Paratext depois de salvar para que as alterações tenham efeito. As alterações valem para todos os projetos deste computador.</sys:String>

    <!-- Panes -->
    <sys:String x:Key="Header_Books">Livros (marque para ocultar)</sys:String>
    <sys:String x:Key="Header_Chapters">Capítulos (marque para ocultar)</sys:String>
    <sys:String x:Key="Header_Entries">Entradas do livro ou dos capítulos selecionados</sys:String>
    <sys:String x:Key="Count_Format">{0} / {1} ocultas</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_HideBook">Ocultar livro</sys:String>
    <sys:String x:Key="Btn_UnhideBook">Mostrar livro</sys:String>
    <sys:String x:Key="Btn_HideChapters">Ocultar capítulo(s)</sys:String>
    <sys:String x:Key="Btn_UnhideChapters">Mostrar capítulo(s)</sys:String>
    <sys:String x:Key="Btn_UnhideAll">Mostrar tudo</sys:String>

    <!-- Entry grid columns (used from code-behind) -->
    <sys:String x:Key="Column_Hidden">Oculta</sys:String>
    <sys:String x:Key="Column_Reference">Referência</sys:String>
    <sys:String x:Key="Column_ParallelWith">Paralela com</sys:String>
    <sys:String x:Key="Column_Text">Texto</sys:String>

    <!-- Status bar / app -->
    <sys:String x:Key="App_Title">Editor de passagens paralelas</sys:String>
    <sys:String x:Key="Status_Unsaved">(não salvo)</sys:String>
    <sys:String x:Key="Status_Saved">Salvo.</sys:String>
    <sys:String x:Key="Status_SummaryFormat">{0} de {1} entradas ocultas</sys:String>

    <!-- Dialogs -->
    <sys:String x:Key="Dlg_SaveErrorTitle">Erro ao salvar</sys:String>
    <sys:String x:Key="Dlg_SaveErrorBody">Não foi possível salvar o arquivo:</sys:String>
    <sys:String x:Key="Dlg_UnsavedTitle">Alterações não salvas</sys:String>
    <sys:String x:Key="Dlg_UnsavedBody">Há alterações não salvas. Salvar antes de continuar?</sys:String>
    <sys:String x:Key="Dlg_OpenTitle">Abrir ParallelPassages.xml</sys:String>
    <sys:String x:Key="Dlg_SaveTitle">Salvar ParallelPassages.xml como</sys:String>
    <sys:String x:Key="Dlg_OpenErrorTitle">Erro ao abrir</sys:String>
    <sys:String x:Key="Dlg_OpenErrorBody">Não foi possível abrir o arquivo:</sys:String>
    <sys:String x:Key="Dlg_NoVersesBody">Nenhuma entrada &lt;Verse&gt; foi encontrada neste arquivo. É um arquivo ParallelPassages.xml?</sys:String>
    <sys:String x:Key="Dlg_NotFoundTitle">Arquivo não encontrado</sys:String>
    <sys:String x:Key="Dlg_NotFoundBody">ParallelPassages.xml não foi encontrado na pasta habitual do Paratext 9 (Program Files\Paratext 9\ParallelPassages). Localize-o, por favor.</sys:String>
    <sys:String x:Key="Dlg_AdminTitle">Permissões de administrador necessárias</sys:String>
    <sys:String x:Key="Dlg_AdminBody" xml:space="preserve">O Windows não permitiu salvar em:&#10;{0}&#10;&#10;São necessárias permissões de administrador para alterar arquivos em Program Files. Reiniciar o editor como administrador? Suas alterações serão mantidas.</sys:String>
    <sys:String x:Key="Dlg_PendingTitle">Alterações mantidas</sys:String>
    <sys:String x:Key="Dlg_PendingAppliedBody">Suas alterações foram mantidas. Clique em Salvar para gravá-las no arquivo.</sys:String>
    <sys:String x:Key="Dlg_PendingStaleBody">O arquivo mudou no disco depois que o editor foi reiniciado, por isso suas alterações anteriores não puderam ser mantidas. Faça-as novamente, por favor.</sys:String>
    <sys:String x:Key="Dlg_ReapplyTitle">Reaplicar a lista de ocultos</sys:String>
    <sys:String x:Key="Dlg_ReapplyBody" xml:space="preserve">Nenhuma entrada está oculta neste arquivo. O Paratext pode tê-lo substituído durante uma atualização.&#10;&#10;Reaplicar sua lista de ocultos anterior ({0} livros, {1} capítulos, {2} entradas avulsas)?</sys:String>
    <sys:String x:Key="Dlg_ReapplyConfirmBody">Substituir as entradas ocultas atuais pela sua lista de ocultos salva ({0} livros, {1} capítulos, {2} entradas avulsas)?</sys:String>
    <sys:String x:Key="Dlg_ReapplyNone">Ainda não há uma lista de ocultos salva. Uma é salva toda vez que você salva o arquivo.</sys:String>
    <sys:String x:Key="Dlg_InvalidXmlBody">O arquivo alterado não seria XML válido, por isso nada foi salvo.</sys:String>

    <!-- Two-entry rule / numbered backups -->
    <sys:String x:Key="Count_KeptFormat">{0} / {1} ocultas, {2} com a passagem</sys:String>
    <sys:String x:Key="Column_Note">Observação</sys:String>
    <sys:String x:Key="Note_Kept">Oculta com a sua passagem: ficariam menos de 2 entradas</sys:String>
    <sys:String x:Key="Status_SummaryKeptFormat">{0} de {1} entradas ocultas; {3} passagens ocultas por completo ({2} entradas só por isso)</sys:String>
    <sys:String x:Key="Status_SavedBackupFormat">Salvo. O arquivo original foi mantido como {0}.</sys:String>
    <sys:String x:Key="Dlg_RepairTitle">Passagens reparadas</sys:String>
    <sys:String x:Key="Dlg_RepairBody">{0} passagens deste arquivo têm menos de 2 entradas visíveis, o que pode impedir o Paratext de carregar. Elas serão ocultadas por completo ao salvar.</sys:String>

    <!-- Per-project saved list -->
    <sys:String x:Key="ProjectBar_Format">Projeto: {0}</sys:String>
    <sys:String x:Key="Check_SaveForProject">Salvar esta lista de ocultos para o projeto {0}</sys:String>
    <sys:String x:Key="Dlg_ProjectListTitle">Lista salva deste projeto</sys:String>
    <sys:String x:Key="Dlg_ProjectListBody" xml:space="preserve">O projeto {0} tem uma lista de ocultos salva ({1} livros, {2} capítulos, {3} entradas avulsas).&#10;&#10;Usá-la? Lembre-se de salvar e depois reiniciar o Paratext.</sys:String>
    <sys:String x:Key="Status_SavedForProject">A lista do projeto {0} é salva quando você fechar esta janela.</sys:String>
    <sys:String x:Key="Status_RemovedForProject">A lista salva do projeto {0} é removida quando você fechar esta janela.</sys:String>

    <!-- Passages added by the user -->
    <sys:String x:Key="Menu_Readd">_Adicionar de novo minhas passagens salvas</sys:String>
    <sys:String x:Key="Btn_AddPassage">Adicionar passagem…</sys:String>
    <sys:String x:Key="Btn_EditPassage">Editar passagem…</sys:String>
    <sys:String x:Key="Btn_RemovePassage">Remover passagem</sys:String>
    <sys:String x:Key="Btn_OK">OK</sys:String>
    <sys:String x:Key="Btn_Cancel">Cancelar</sys:String>
    <sys:String x:Key="Note_Added">Adicionada por você</sys:String>
    <sys:String x:Key="Status_AddedFormat">{0} passagens adicionadas por você</sys:String>
    <sys:String x:Key="Dlg_AddPassageTitle">Adicionar uma passagem paralela</sys:String>
    <sys:String x:Key="Dlg_EditPassageTitle">Editar uma passagem paralela</sys:String>
    <sys:String x:Key="Dlg_AddPassageHelp" xml:space="preserve">Digite as referências da passagem paralela, uma por linha (pelo menos 2), por exemplo:&#10;GEN 2:24&#10;MAT 19:5&#10;MRK 10:7-8&#10;Use a versificação Original, como na lista do Paratext. O Paratext não tem comparação palavra por palavra para as passagens que você adiciona, então suas palavras não são destacadas.</sys:String>
    <sys:String x:Key="Dlg_AddPassageNoVrs">O Paratext 9 não foi encontrado em Arquivos de Programas, então só a forma de cada referência é verificada, não se o versículo existe.</sys:String>
    <sys:String x:Key="Dlg_RemovePassageTitle">Remover passagem</sys:String>
    <sys:String x:Key="Dlg_RemovePassageBody">Remover a passagem {0}?</sys:String>
    <sys:String x:Key="Dlg_ReaddTitle">Passagens que você adicionou</sys:String>
    <sys:String x:Key="Dlg_ReaddBody" xml:space="preserve">{0} passagens que você adicionou antes não estão neste arquivo. O Paratext pode tê-lo substituído durante uma atualização.&#10;&#10;{1}&#10;&#10;Adicioná-las de novo?</sys:String>
    <sys:String x:Key="Dlg_ReaddNone">Todas as passagens que você adicionou estão neste arquivo. A lista é salva toda vez que você salva o arquivo.</sys:String>
    <sys:String x:Key="Dlg_PassageErrorTitle">Passagem</sys:String>
    <sys:String x:Key="Err_LineFormat">Referência {0}: {1}</sys:String>
    <sys:String x:Key="Err_BadRef">&quot;{0}&quot; não é uma referência como GEN 2:24, MRK 10:7-8 ou 2CH 8:13,16.</sys:String>
    <sys:String x:Key="Err_Book">{0} não é um livro do Antigo nem do Novo Testamento.</sys:String>
    <sys:String x:Key="Err_Order">&quot;{0}&quot;: os versículos devem estar em ordem (10:7-8, 8:13,16).</sys:String>
    <sys:String x:Key="Err_Chapter">{0} não existe: {1} tem {2} capítulos na versificação Original.</sys:String>
    <sys:String x:Key="Err_Verse">&quot;{0}&quot; não existe: {1} tem {2} versículos na versificação Original.</sys:String>
    <sys:String x:Key="Err_Duplicate">{0} já é a referência {1}.</sys:String>
    <sys:String x:Key="Err_TooFew">Uma passagem precisa de pelo menos 2 referências.</sys:String>
    <sys:String x:Key="Err_Exists">Esta passagem já está no arquivo (linha {0}: {1}).</sys:String>

</ResourceDictionary>
