<Window x:Class="ParallelPassagesEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ParallelPassagesEditor"
        Title="Parallel Passages Editor"
        Height="720" Width="1100"
        MinHeight="420" MinWidth="720"
        Closing="Window_Closing">

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open"
                        Executed="Open_Executed"
                        CanExecute="Always_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Save"
                        Executed="Save_Executed"
                        CanExecute="HasDocument_CanExecute"/>
        <CommandBinding Command="{x:Static local:MainWindow.SaveAsCommand}"
                        Executed="SaveAs_Executed"
                        CanExecute="HasDocument_CanExecute"/>
    </Window.CommandBindings>

    <Window.Resources>
        <Style x:Key="PaneHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="6,6,6,4"/>
        </Style>
        <!-- Book/chapter rows: a dark border on selected rows that stays dark when the list
             loses focus (the default highlight is faint, and fades to grey when unfocused). -->
        <Style x:Key="SelectableItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="2"
                                Padding="3,2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF4FB"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D6E6F7"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1F3A5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu_File}">
                <MenuItem Header="{DynamicResource Menu_Open}"   Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Save}"   Command="ApplicationCommands.Save"/>
                <MenuItem Header="{DynamicResource Menu_SaveAs}" Command="{x:Static local:MainWindow.SaveAsCommand}"/>
                <Separator/>
                <MenuItem x:Name="ReapplyMenuItem" Header="{DynamicResource Menu_Reapply}" Click="Reapply_Click"/>
                <MenuItem x:Name="ReaddMenuItem" Header="{DynamicResource Menu_Readd}" Click="Readd_Click"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu_Exit}" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- File identity bar -->
        <Border DockPanel.Dock="Top"
                Background="#E8EEF7"
                BorderBrush="#C3D2E8"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <TextBlock x:Name="FileHeaderText"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"/>
        </Border>

        <!-- Restart reminder banner -->
        <Border DockPanel.Dock="Top"
                Background="#FFF3CD"
                BorderBrush="#FFEAA0"
                BorderThickness="0,0,0,1"
                Padding="10,4">
            <TextBlock Text="{DynamicResource Banner_RestartReminder}"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Foreground="#856404"/>
        </Border>

        <!-- Language toolbar -->
        <Border DockPanel.Dock="Top"
                Background="#F5F5F5"
                BorderBrush="#D0D0D0"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Toolbar_Language}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="LanguageCombo"
                          Width="130"
                          SelectionChanged="LanguageCombo_SelectionChanged"/>
                <!-- Shown only when opened from a project (the project command-line option). Ticked: Save also writes the
                     list to <project>\local\ParallelPassagesEditor\hidden.txt; unticked: Save removes it. -->
                <CheckBox x:Name="ProjectOptionCheck"
                          Visibility="Collapsed"
                          VerticalAlignment="Center"
                          Margin="24,0,0,0"/>
            </WrapPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Main content: books | chapters | entries -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260" MinWidth="160"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Books -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" Text="{DynamicResource Header_Books}"/>
                <Border DockPanel.Dock="Bottom" Background="#EFEFEF" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="6">
                    <WrapPanel>
                        <Button x:Name="HideBookBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_HideBook}" Click="HideBook_Click"/>
                        <Button x:Name="UnhideBookBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_UnhideBook}" Click="UnhideBook_Click"/>
                    </WrapPanel>
                </Border>
                <ListBox x:Name="BookList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SelectableItem}"
                         SelectionMode="Extended"
                         SelectionChanged="BookList_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsHidden, Mode=OneWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          Click="BookCheck_Click"/>
                                <TextBlock Grid.Column="1" Text="{Binding Book}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" ToolTip="{Binding CountText}" TextTrimming="CharacterEllipsis" Foreground="#666666" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Chapters -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" Text="{DynamicResource Header_Chapters}"/>
                <Border DockPanel.Dock="Bottom" Background="#EFEFEF" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="6">
                    <WrapPanel>
                        <Button x:Name="HideChaptersBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_HideChapters}" Click="HideChapters_Click"/>
                        <Button x:Name="UnhideChaptersBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_UnhideChapters}" Click="UnhideChapters_Click"/>
                    </WrapPanel>
                </Border>
                <ListBox x:Name="ChapterList"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource SelectableItem}"
                         SelectionMode="Extended"
                         SelectionChanged="ChapterList_SelectionChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsHidden, Mode=OneWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0"
                                          Click="ChapterCheck_Click"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CountText}" ToolTip="{Binding CountText}" TextTrimming="CharacterEllipsis" Foreground="#666666" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Entries of the selected chapters (read-only) -->
            <DockPanel Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PaneHeader}" Text="{DynamicResource Header_Entries}"/>
                <Border DockPanel.Dock="Bottom" Background="#EFEFEF" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="6">
                    <WrapPanel>
                        <Button x:Name="UnhideAllBtn" Style="{StaticResource ActionButton}" Margin="0,0,18,4"
                                Content="{DynamicResource Btn_UnhideAll}" Click="UnhideAll_Click"/>
                        <!-- Passages added with this editor: only those can be edited or removed. -->
                        <Button x:Name="AddPassageBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_AddPassage}" Click="AddPassage_Click"/>
                        <Button x:Name="EditPassageBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_EditPassage}" Click="EditPassage_Click"/>
                        <Button x:Name="RemovePassageBtn" Style="{StaticResource ActionButton}" Margin="0,0,6,4"
                                Content="{DynamicResource Btn_RemovePassage}" Click="RemovePassage_Click"/>
                    </WrapPanel>
                </Border>
                <DataGrid x:Name="EntryGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F8F8"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="#D0D0D0"
                          SelectionChanged="EntryGrid_SelectionChanged"
                          MouseDoubleClick="EntryGrid_MouseDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <!-- In a passage added with this editor -->
                                <DataTrigger Binding="{Binding IsUserAdded}" Value="True">
                                    <Setter Property="Foreground" Value="#1A4E8A"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                                <!-- Not asked to be hidden, but hidden because the whole passage is -->
                                <DataTrigger Binding="{Binding IsHiddenWithPassage}" Value="True">
                                    <Setter Property="Foreground" Value="#8A5A00"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Hidden"
                                                Binding="{Binding IsEffectivelyHidden, Mode=OneWay}"
                                                Width="64"/>
                        <DataGridTextColumn Header="Reference"
                                            Binding="{Binding Reference}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Parallel with"
                                            Binding="{Binding ParallelWith}"
                                            Width="*"/>
                        <DataGridTextColumn Header="Text"
                                            Binding="{Binding Language}"
                                            Width="50"/>
                        <DataGridTextColumn Header="Note"
                                            Binding="{Binding Note}"
                                            Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
