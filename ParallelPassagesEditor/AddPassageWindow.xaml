<Window x:Class="ParallelPassagesEditor.AddPassageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Dlg_AddPassageTitle}"
        Width="520" Height="440"
        MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top"
                   Text="{DynamicResource Dlg_AddPassageHelp}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkBtn" Content="{DynamicResource Btn_OK}" MinWidth="80" Padding="10,3" Margin="0,0,6,0"
                    IsDefault="False" Click="Ok_Click"/>
            <Button Content="{DynamicResource Btn_Cancel}" MinWidth="80" Padding="10,3" IsCancel="True"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText"
                   DockPanel.Dock="Bottom"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>
        <TextBlock x:Name="NoteText"
                   DockPanel.Dock="Bottom"
                   Foreground="#666666"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"/>
        <TextBox x:Name="RefsBox"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="14"
                 TextChanged="RefsBox_TextChanged"/>
    </DockPanel>
</Window>
