<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="ParallelPassagesEditor.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- TEST BUILDS ONLY (never deployed): same as app.manifest but asInvoker, so UI Automation can drive the window from a normal shell. Build with /p:ApplicationManifest=app.asInvoker.manifest /p:OutputPath=bin\UiTest\ -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>

